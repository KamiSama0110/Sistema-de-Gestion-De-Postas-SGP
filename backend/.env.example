APP_NAME=Sistema de Gestion de Postas
APP_VERSION=1.0.0
DEBUG=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sgp_db
DB_USER=sgp_user
DB_PASSWORD=sgp_password

# Opcional. Si se define, tiene prioridad y se ignoran DB_HOST, DB_PORT,
# DB_NAME, DB_USER y DB_PASSWORD.
# DATABASE_URL=postgresql+asyncpg://sgp_user:sgp_password@localhost:5432/sgp_db

SECRET_KEY=cambia-esta-clave-segura-a-32-o-mas-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

CORS_ORIGINS=http://localhost:5173

# Seed automatico al arrancar (util en despliegues demo). false por defecto.
SEED_DB=false

# Panel del cuadro
MAX_GUARDIAS_CUADRO_POR_MES=1
